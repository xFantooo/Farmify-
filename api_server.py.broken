@app.route('/api/wall-upgrader/start', methods=['POST'])
def start_wall_upgrader():
    """Start automated wall upgrading"""
    try:
        data = request.get_json()
        
        # VIP FEATURE CHECK
        has_wall_access = license_manager.has_feature_access('wall_upgrader')
        if not has_wall_access:
            logger.warning("User attempted to use Wall Upgrader without VIP license")
            return jsonify({
                'error': 'Wall Upgrader is a VIP-only feature. Please upgrade to VIP to use this feature.',
                'vip_required': True
            }), 403
        
        # Extract configuration
        wall_upgrade_interval = data.get('wall_upgrade_interval', 2)
        walls_per_upgrade = data.get('walls_per_upgrade', 3)
        attacks_per_upgrade_cycle = data.get('attacks_per_upgrade_cycle', 10)
        auto_collect_resources = data.get('auto_collect_resources', True)
        preferred_resource = data.get('preferred_resource', 'gold')
        stop_when_resources_low = data.get('stop_when_resources_low', True)
        min_gold_reserve = data.get('min_gold_reserve', 100000)
        min_elixir_reserve = data.get('min_elixir_reserve', 100000)
        
        # LOOT MANAGEMENT FOR ATTACK CYCLE (separate from Auto Attack)
        enable_loot_check = data.get('enable_loot_check', False)
        min_loot_gold = data.get('min_loot_gold', 500000)
        min_loot_elixir = data.get('min_loot_elixir', 500000)
        min_loot_dark = data.get('min_loot_dark', 0)
        attack_sessions = data.get('attack_sessions', [])
        
        logger.info(f"Starting Wall Upgrader: resource={preferred_resource}, "
                   f"attacks_per_cycle={attacks_per_upgrade_cycle}, walls_per_upgrade={walls_per_upgrade}")
        if enable_loot_check:
            logger.info(f"Wall Upgrader LOOT CHECK enabled: Gold≥{min_loot_gold:,}, Elixir≥{min_loot_elixir:,}, Dark≥{min_loot_dark:,}")
        
        # Start wall upgrader with loot parameters
        bot.start_wall_upgrader(
            wall_upgrade_interval=wall_upgrade_interval,
            walls_per_upgrade=walls_per_upgrade,
            auto_collect_resources=auto_collect_resources,
            preferred_resource=preferred_resource,
            stop_when_resources_low=stop_when_resources_low,
            min_gold_reserve=min_gold_reserve,
            min_elixir_reserve=min_elixir_reserve,
            attacks_per_upgrade_cycle=attacks_per_upgrade_cycle,
            min_loot_gold=min_loot_gold,
            min_loot_elixir=min_loot_elixir,
            min_loot_dark=min_loot_dark,
            loot_check_enabled=enable_loot_check,
            attack_sessions=attack_sessions
        )
        
        bot_state['wall_upgrader_running'] = True
        
        return jsonify({'success': True, 'message': 'Wall Upgrader started'})
        
    except Exception as e:
        logger.error(f"Error starting wall upgrader: {e}")
        return jsonify({'error': str(e)}), 500


@app.route('/api/wall-upgrader/stop', methods=['POST'])
def stop_wall_upgrader():
    """Stop wall upgrading automation"""
    try:
        bot.stop_wall_upgrader()
        bot_state['wall_upgrader_running'] = False
        
        logger.info("Wall Upgrader stopped")
        return jsonify({'success': True, 'message': 'Wall Upgrader stopped'})
        
    except Exception as e:
        logger.error(f"Error stopping wall upgrader: {e}")
        return jsonify({'error': str(e)}), 500


