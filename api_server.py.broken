@app.route('/api/license/activate', methods=['POST'])
def activate_license():
    """Activate a VIP license"""
    try:
        data = request.get_json()
        license_key = data.get('license_key')
        plan = data.get('plan', 'monthly')
        
        if not license_key:
            return jsonify({'success': False, 'error': 'License key is required'}), 400
        
        logger.info(f"Attempting to activate license: {license_key[:20]}...")
        
        try:
            result = license_manager.activate_license(license_key, plan)
        except OSError as e:
            if e.errno == 22:
                logger.error(f"[Errno 22] Invalid argument - license save failed")
                logger.error(f"This is usually a file path issue. License file: {license_manager.license_file}")
                return jsonify({
                    'success': False,
                    'error': 'License activation failed - file write error (Errno 22)',
                    'details': 'Please restart the application and try again'
                }), 500
            else:
                raise
        
        if result.get('success'):
            logger.info(f"VIP license activated: {plan} plan")
            return jsonify(result)
        else:
            logger.warning(f"License activation failed: {result.get('error')}")
            return jsonify(result), 400
            
    except Exception as e:
        logger.error(f"Error activating license: {e}")
        import traceback
        logger.error(traceback.format_exc())
        return jsonify({'success': False, 'error': str(e)}), 500


@app.route('/api/license/deactivate', methods=['POST'])
def deactivate_license():
    """Deactivate VIP license"""
    try:
        try:
            success = license_manager.deactivate_license()
        except OSError as e:
            if e.errno == 22:
                logger.error(f"[Errno 22] Invalid argument - license file error")
                logger.error(f"File path may have invalid characters: {license_manager.license_file}")
                return jsonify({
                    'success': False,
                    'error': 'License file error (Errno 22)',
                    'details': 'File write failed - please restart the application'
                }), 500
            else:
                raise
        
        if success:
            logger.info("VIP license deactivated")
            return jsonify({'success': True, 'message': 'License deactivated'})
        else:
            logger.warning("License deactivation returned False")
            return jsonify({'success': False, 'error': 'Failed to deactivate'}), 500
    except Exception as e:
        logger.error(f"Error deactivating license: {e}", exc_info=True)
        return jsonify({'success': False, 'error': str(e)}), 500


