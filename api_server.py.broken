# ============================================================================
# MANUAL LICENSE ISSUANCE ENDPOINTS (Admin Use)
# ============================================================================

@app.route('/api/admin/issue-license', methods=['POST'])
def issue_license_manual():
    """
    Manually issue a license key to a user
    Request body: {
        "email": "user@example.com",
        "plan_id": "monthly" or "annual",
        "send_email": true (optional, default: true)
    }
    """
    try:
        data = request.get_json()
        
        if not data:
            return jsonify({'success': False, 'error': 'No data provided'}), 400
        
        email = data.get('email', '').strip()
        plan_id = data.get('plan_id', '').lower()
        send_email = data.get('send_email', True)
        
        # Validate input
        if not email or '@' not in email:
            return jsonify({'success': False, 'error': 'Invalid email address'}), 400
        
        if plan_id not in ['monthly', 'annual']:
            return jsonify({'success': False, 'error': 'Invalid plan_id. Use "monthly" or "annual"'}), 400
        
        logger.info(f"📝 Issuing manual license - Email: {email}, Plan: {plan_id}")
        
        # Generate license key
        license_key = license_manager.generate_license_key(plan_id)
        
        # Activate the license
        activation_result = license_manager.activate_license(license_key, plan_id)
        
        if not activation_result['success']:
            logger.error(f"Failed to activate license: {activation_result.get('error')}")
            return jsonify({
                'success': False,
                'error': f"Failed to activate license: {activation_result.get('error')}"
            }), 500
        
        logger.info(f"✅ Manual license issued: {license_key}")
        
        # Log as manual issuance
        transaction_data = {
            'invoice_id': f"MANUAL-{plan_id.upper()}-{int(datetime.now().timestamp())}",
            'transaction_id': f"MANUAL-{int(datetime.now().timestamp())}",
            'plan_id': plan_id,
            'amount': 0,  # Manual issuance, no payment
            'status': 'verified',  # Already verified since manual
            'email': email,
            'hardware_id': 'N/A',
            'license_key': license_key,
            'notes': 'Manually issued by admin'
        }
        transaction_logger.log_transaction(transaction_data)
        
        # Send email if requested
        if send_email:
            license_status = license_manager.get_license_status()
            expiry_date = license_status.get('expiry_date', 'Unknown')
            
            email_notifier.send_license_activation(
                recipient_email=email,
                plan_id=plan_id,
                license_key=license_key,
                expiry_date=expiry_date
            )
            logger.info(f"📧 License email sent to {email}")
        
        return jsonify({
            'success': True,
            'license_key': license_key,
            'plan_id': plan_id,
            'email': email,
            'message': f'License issued successfully and email sent' if send_email else 'License issued successfully (no email sent)'
        }), 200
        
    except Exception as e:
        logger.error(f"Error issuing manual license: {e}")
        return jsonify({'success': False, 'error': str(e)}), 500


@app.route('/api/admin/licenses', methods=['GET'])
def get_all_licenses():
    """
    Get all issued licenses (for admin dashboard)
    Returns all transactions that have licenses
    """
    try:
        transactions = transaction_logger.get_all_transactions()
        
        licenses = []
        for tx in transactions:
            if tx.get('license_key'):
                licenses.append({
                    'license_key': tx.get('license_key'),
                    'email': tx.get('email'),
                    'plan_id': tx.get('plan_id'),
                    'status': tx.get('status'),
                    'issued_at': tx.get('activated_at') or tx.get('timestamp'),
                    'invoice_id': tx.get('invoice_id'),
                    'transaction_id': tx.get('transaction_id')
                })
        
        return jsonify({
            'success': True,
            'total': len(licenses),
            'licenses': licenses
        }), 200
        
    except Exception as e:
        logger.error(f"Error getting licenses: {e}")
        return jsonify({'success': False, 'error': str(e)}), 500


@app.route('/api/admin/licenses/revoke', methods=['POST'])
def revoke_license():
    """
    Revoke a previously issued license
    Request body: {
        "license_key": "FARM-MONTHLY-1234567890-ABC123",
        "reason": "Refund requested" (optional)
    }
    """
    try:
        data = request.get_json()
        
        if not data or not data.get('license_key'):
            return jsonify({'success': False, 'error': 'License key required'}), 400
        
        license_key = data.get('license_key')
        reason = data.get('reason', 'Manual revocation')
        
        logger.info(f"🔴 Revoking license: {license_key} - Reason: {reason}")
        
        # Deactivate the license
        license_manager.deactivate_license()
        
        # Update transaction
        transaction_logger.mark_refunded(license_key, f"Revoked: {reason}")
        
        logger.info(f"✅ License revoked: {license_key}")
        
        return jsonify({
            'success': True,
            'message': f'License {license_key} has been revoked'
        }), 200
        
    except Exception as e:
        logger.error(f"Error revoking license: {e}")
        return jsonify({'success': False, 'error': str(e)}), 500


