    'is_auto_attacking': False,
    'is_recording': False,
    'current_recording': None,
}


# ============================================================================
# STATUS & STATS ENDPOINTS
# ============================================================================

@app.route('/api/status', methods=['GET'])
def get_status():
    """Get current bot status"""
    try:
        is_auto_attacking = bot.is_auto_attacking()
        is_recording = bot_state['is_recording']
        is_wall_upgrading = bot.is_wall_upgrader_running()
        
        # Determine status and mode for frontend
        if is_auto_attacking:
            status = 'running'
            mode = 'auto_attack'
        elif is_wall_upgrading:
            status = 'running'
            mode = 'wall_upgrader'
        elif is_recording:
            status = 'stopped'  # Recording is not a "running" bot mode
            mode = 'recording'
        else:
            status = 'stopped'
            mode = None
        
        return jsonify({
            'status': status,
            'mode': mode,
            'is_running': is_auto_attacking or is_wall_upgrading,
            'is_auto_attacking': is_auto_attacking,
            'is_recording': is_recording,
            'is_wall_upgrading': is_wall_upgrading,
            'current_recording': bot_state['current_recording'],
            'timestamp': datetime.now().isoformat()
        })
    except Exception as e:
        logger.error(f"Error getting status: {e}")
        return jsonify({'error': str(e)}), 500


@app.route('/api/stats', methods=['GET'])
def get_stats():
    """Get bot statistics - returns accumulated stats even when bot is not running"""
    try:
        # Always get stats from auto_attacker, whether running or not
        # This ensures accumulated stats persist until app closes
        stats = bot.get_auto_attack_stats()
        return jsonify(stats)
    except Exception as e:
        logger.error(f"Error getting stats: {e}")
        return jsonify({
            'is_running': False,
            'total_attacks': 0,
            'successful_attacks': 0,
            'failed_attacks': 0,
            'success_rate': 0,
            'runtime_hours': 0,
            'attacks_per_hour': 0,
            'last_attack': 'N/A',
            'configured_sessions': []
        }), 500


# ============================================================================
# AUTO ATTACK ENDPOINTS
# ============================================================================

@app.route('/api/auto-attack/start', methods=['POST'])
def start_auto_attack():
    """Start auto attack system"""
    try:
        data = request.get_json()
        
        # FIRST: Validate coordinates are properly mapped before starting
        coords = bot.get_mapped_coordinates()
        required_buttons = ['attack', 'find_a_match', 'launch_attack', 'next_button', 'end_battle', 'confirm', 'return_home']
        
        missing_buttons = []
        invalid_buttons = []
        
        for button in required_buttons:
            if button not in coords:
                missing_buttons.append(button)
            elif not coords[button] or 'x' not in coords[button] or 'y' not in coords[button]:
                invalid_buttons.append(button)
        
        if missing_buttons or invalid_buttons:
            error_msg = ""
            if missing_buttons:
                error_msg += f"Missing button mappings: {missing_buttons}. "
            if invalid_buttons:
                error_msg += f"Invalid button coordinates: {invalid_buttons}. "
            error_msg += "Please map all buttons in Coordinate Mapper before starting auto attack."
            
            logger.error(f"[AUTO ATTACK] Validation failed: {error_msg}")
            print(f"[AUTO ATTACK] COORDINATES STATUS:")
            for button, coord in coords.items():
                status = "✅ VALID" if (coord and 'x' in coord and 'y' in coord) else "❌ INVALID"
                print(f"  {button}: {coord} [{status}]")
            
            return jsonify({
                'error': error_msg,
                'missing': missing_buttons,
                'invalid': invalid_buttons,
                'coordinates': coords
            }), 400
        
        logger.info("[AUTO ATTACK] ✅ All button coordinates validated successfully")
        print(f"[AUTO ATTACK] COORDINATES STATUS (VALID):")
        for button, coord in coords.items():
            print(f"  ✅ {button}: ({coord['x']}, {coord['y']})")
        

        # Extract attack sessions list
        attacks = data.get('attacks', [])
        buttons_sequence = data.get('buttons_sequence', [])
        
        if not buttons_sequence:
            return jsonify({'error': 'No buttons configured - map buttons in Coordinate Mapper first'}), 400
        
        # Extract loot management parameters
        enable_loot_check = data.get('enable_loot_check', False)
        min_gold = data.get('min_loot_gold', 500000)
        min_elixir = data.get('min_loot_elixir', 500000)
        min_dark_elixir = data.get('min_loot_dark_elixir', 0)
        attack_interval = data.get('attack_interval', 30)
        battle_duration = data.get('battle_duration', 180)
        
        # Log the request for debugging
        logger.info("="*80)
        logger.info("[AUTO ATTACK START] ============== REQUEST RECEIVED ==============")
        logger.info("="*80)
        
        # Sanitize attack names for safe logging
        import re
        sanitized_attacks = []
        for attack in attacks:
            if attack:
                sanitized = re.sub(r'[<>:"/\\|?*]', '', str(attack))
                sanitized = sanitized.encode('ascii', 'ignore').decode('ascii')
                sanitized_attacks.append(sanitized)
        
        logger.info(f"[AUTO ATTACK] Attacks array: {sanitized_attacks}")
        logger.info(f"[AUTO ATTACK] Buttons sequence: {buttons_sequence}")
        logger.info(f"[AUTO ATTACK] Enable loot check: {enable_loot_check}")
        logger.info(f"[AUTO ATTACK] Min Gold: {min_gold:,}, Min Elixir: {min_elixir:,}, Min Dark: {min_dark_elixir:,}")
        logger.info(f"[AUTO ATTACK] Attack interval: {attack_interval}s, Battle duration: {battle_duration}s")
        logger.info("="*80)
        
        
        # VIP FEATURE CHECK: Validate loot management access
        if enable_loot_check:
            # Check if user has VIP license with loot management feature
            has_loot_access = license_manager.has_feature_access('auto_attack_loot_management')
            
            if not has_loot_access:
                logger.warning("User attempted to use loot management without VIP license")
                return jsonify({
                    'error': 'Loot Management is a VIP-only feature. Please upgrade to VIP to use this feature.',
                    'vip_required': True
                }), 403
            
            logger.info(f"VIP user starting auto attack WITH LOOT CHECKING (min_gold={min_gold}, min_elixir={min_elixir})")
        else:
            # Free user - basic auto attack without loot management
            logger.info("Starting basic auto attack WITHOUT LOOT CHECKING")
            # Force disable loot parameters for free users
            min_gold = 0
            min_elixir = 0
            min_dark_elixir = 0
        
        # Start auto attack with the enable_loot_check flag
        bot.start_auto_attack(attacks, min_gold, min_elixir, min_dark_elixir, 
                            buttons_sequence, attack_interval, battle_duration, enable_loot_check)
        bot_state['is_auto_attacking'] = True
        
        logger.info(f"Auto attack started with buttons: {buttons_sequence}")
        return jsonify({'success': True, 'message': 'Auto attack started'})
        
    except Exception as e:
        logger.error(f"Error starting auto attack: {e}")
        return jsonify({'error': str(e)}), 500


@app.route('/api/auto-attack/stop', methods=['POST'])
def stop_auto_attack():
    """Stop auto attack system with improved error handling"""
    try:
        bot.stop_auto_attack()
        bot_state['is_auto_attacking'] = False
        
        logger.info("Auto attack stopped")
        return jsonify({'success': True, 'message': 'Auto attack stopped'})
        
    except Exception as e:
        # Log the error but still update the state
        logger.error(f"Error stopping auto attack: {e}")
        
        # Force update state even if stop failed
        # (the process might have already terminated)
        bot_state['is_auto_attacking'] = False
        
        # Return success since we've updated the state
        return jsonify({
            'success': True, 
            'message': 'Auto attack stopped',
            'note': 'Process may have already terminated'
        })


# ============================================================================
# ATTACK RECORDING & PLAYBACK ENDPOINTS
# ============================================================================

@app.route('/api/attacks/recorded', methods=['GET'])
def get_recorded_attacks():
    """Get list of recorded attacks"""
    try:
        logger.info("[API] Getting recorded attacks...")
        attacks = bot.list_recorded_attacks()
        logger.info(f"[API] Got {len(attacks)} attacks")
        
        # Sanitize attack names for safe JSON return and logging
        cleaned_attacks = []
        for attack in attacks:
            try:
                # Sanitize the attack name - remove/replace invalid characters
                import re
                # Remove invalid Windows characters
                sanitized = re.sub(r'[<>:"/\\|?*]', '', attack)
                # Remove accents and non-ASCII
                sanitized = sanitized.encode('ascii', 'ignore').decode('ascii')
                sanitized = ' '.join(sanitized.split())  # Clean up spaces
                
                cleaned_attacks.append(sanitized)
                # Log the sanitized version only
                logger.info(f"[API] Attack: {sanitized}")
            except Exception as e:
                logger.error(f"[API] Error processing attack name: {e}, skipping")
        
        result = {'attacks': cleaned_attacks}
        logger.info(f"[API] Returning {len(cleaned_attacks)} attacks")
        return jsonify(result)
    except Exception as e:
        logger.error(f"[API] Error getting recorded attacks: {e}", exc_info=True)
        return jsonify({'error': str(e)}), 500


@app.route('/api/attacks/delete', methods=['POST'])
def delete_recorded_attack():
    """Delete a recorded attack"""
    try:
        data = request.get_json()
        attack_name = data.get('attack_name', '')
        
        if not attack_name:
            return jsonify({'error': 'No attack name provided'}), 400
        
        result = bot.delete_recorded_attack(attack_name)
        if result:
            return jsonify({'success': True, 'message': f'Attack "{attack_name}" deleted successfully'})
        else:
            return jsonify({'error': f'Failed to delete attack "{attack_name}"'}), 400
    except Exception as e:
        logger.error(f"Error deleting recorded attack: {e}")
        return jsonify({'error': str(e)}), 500


@app.route('/api/recording/start', methods=['POST'])
def start_recording():
    """Start recording an attack"""
    try:
        data = request.get_json()
        name = data.get('name', '')
        
        # Sanitize the name before logging
        import re
        safe_name = re.sub(r'[<>:"/\\|?*]', '', name)
        safe_name = safe_name.encode('ascii', 'ignore').decode('ascii')
        
        logger.info(f"[RECORDING] Start recording request received: name='{safe_name}'")
        
        if not name:
            logger.error("[RECORDING] No name provided")
            return jsonify({'error': 'Recording name is required'}), 400
        
        # Call the correct method name from BotController
        logger.info(f"[RECORDING] Calling bot.start_attack_recording('{safe_name}')")
        bot.start_attack_recording(name)
        bot_state['is_recording'] = True
        bot_state['current_recording'] = name
        
        logger.info(f"[RECORDING] Recording started successfully: {safe_name}")
        return jsonify({'success': True, 'message': f'Recording started: {name}'})
        
    except Exception as e:
        logger.error(f"[RECORDING] ❌ Error starting recording: {e}")
        import traceback
        logger.error(f"[RECORDING] Traceback: {traceback.format_exc()}")
        return jsonify({'error': str(e)}), 500


@app.route('/api/recording/stop', methods=['POST'])
def stop_recording():
    """Stop recording an attack"""
    try:
        recording_name = bot_state.get('current_recording', 'Unknown')
        logger.info(f"Stop recording request for: {recording_name}")
        
        # FIXED: Use stop_attack_recording instead of stop_recording
        bot.stop_attack_recording()
        bot_state['is_recording'] = False
        bot_state['current_recording'] = None
        
        logger.info(f"Recording stopped successfully: {recording_name}")
        return jsonify({'success': True, 'message': f'Recording saved: {recording_name}'})
        
    except Exception as e:
        logger.error(f"❌ Error stopping recording: {e}")
        # Reset state even on error
        bot_state['is_recording'] = False
        bot_state['current_recording'] = None
        return jsonify({'error': str(e)}), 500


@app.route('/api/attacks/play', methods=['POST'])
def play_attack():
    """Play a recorded attack"""
    try:
        data = request.get_json()
        attack_name = data.get('name', '')
        
        if not attack_name:
            return jsonify({'error': 'Attack name is required'}), 400
        
        bot.play_attack(attack_name)
        logger.info(f"Playing attack: {attack_name}")
        return jsonify({'success': True, 'message': f'Playing: {attack_name}'})
        
    except Exception as e:
        logger.error(f"Error playing attack: {e}")
        return jsonify({'error': str(e)}), 500


