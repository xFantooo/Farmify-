@app.route('/api/coordinates', methods=['POST'])
def save_coordinates():
    """Save button coordinates"""
    try:
        data = request.get_json()
        name = data.get('name', '')
        coordinates = data.get('coordinates', {})
        
        logger.info(f"[COORDINATE SAVE] Received request for button: {name}")
        logger.info(f"[COORDINATE SAVE] Raw coordinates data: {coordinates}")
        
        if not name:
            logger.error("[COORDINATE SAVE] ERROR: Button name is required")
            return jsonify({'error': 'Button name is required'}), 400
        
        if not coordinates:
            logger.error("[COORDINATE SAVE] ERROR: Coordinates are required")
            return jsonify({'error': 'Coordinates are required'}), 400
        
        x = coordinates.get('x')
        y = coordinates.get('y')
        
        logger.info(f"[COORDINATE SAVE] Button: {name}")
        logger.info(f"[COORDINATE SAVE] X: {x}")
        logger.info(f"[COORDINATE SAVE] Y: {y}")
        logger.info(f"[COORDINATE SAVE] Type X: {type(x)}, Type Y: {type(y)}")
        
        bot.save_coordinates(name, coordinates)
        
        logger.info(f"[COORDINATE SAVE] ✅ Successfully saved coordinates for {name}: ({x}, {y})")
        return jsonify({'success': True, 'message': f'Coordinates saved for {name}'})
        
    except Exception as e:
        logger.error(f"[COORDINATE SAVE] ERROR: {str(e)}")
        logger.error(f"[COORDINATE SAVE] Full request data: {request.get_json()}")
        return jsonify({'error': str(e)}), 500


@app.route('/api/coordinates/capture', methods=['POST'])
def capture_coordinates():
    """Capture global mouse click coordinates from game window"""
    try:
        from src.utils.mouse_listener import capture_click
        
        data = request.get_json()
        button_name = data.get('button_name', 'Unknown')
        
        logger.info(f"Starting global mouse listener for {button_name}...")
        
        try:
            # Wait for mouse click (30 second timeout)
            coordinates = capture_click(timeout=30)
        except OSError as e:
            # Handle Windows-specific errors (Errno 22 and others)
            if e.errno == 22:
                logger.error(f"[Errno 22] Invalid argument - pynput mouse listener failed")
                logger.error(f"This may be due to Windows 11 compatibility issues")
                return jsonify({
                    'error': 'Mouse listener error (Errno 22)',
                    'message': 'The mouse listener encountered a system error. Please try again or restart the application.',
                    'details': str(e)
                }), 500
            else:
                raise
        
        if coordinates:
            logger.info(f"Captured coordinates for {button_name}: {coordinates}")
            return jsonify({
                'success': True,
                'coordinates': coordinates,
                'message': f'Captured {button_name} at ({coordinates["x"]}, {coordinates["y"]})'
            })
        else:
            logger.warning(f"No coordinates captured for {button_name} - timeout reached")
            return jsonify({
                'error': 'No click captured - timeout reached',
                'message': 'Please try again and click on the button within 30 seconds'
            }), 408
        
    except ImportError as e:
        logger.error(f"Failed to import mouse_listener: {e}")
        return jsonify({'error': f'Mouse listener module not available: {str(e)}'}), 500
    except Exception as e:
        logger.error(f"Error capturing coordinates: {e}")
        import traceback
        logger.error(traceback.format_exc())
        return jsonify({'error': f'Failed to capture coordinates: {str(e)}'}), 500


