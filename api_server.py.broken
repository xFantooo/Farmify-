@app.route('/api/screenshots', methods=['GET'])
def get_screenshots():
    """Get list of screenshots"""
    try:
        # Use centralized path management for consistency
        from src.utils.app_paths import get_screenshots_dir
        screenshots_dir = get_screenshots_dir()
        logger.info(f"[API] Reading screenshots from: {screenshots_dir}")
        
        if os.path.exists(screenshots_dir):
            screenshots = [f for f in os.listdir(screenshots_dir) if f.endswith(('.png', '.jpg', '.jpeg', '.gif'))]
            logger.info(f"[API] Found {len(screenshots)} screenshots in {screenshots_dir}")
        else:
            logger.warning(f"[API] Screenshots directory does not exist: {screenshots_dir}")
            screenshots = []
        
        return jsonify({'screenshots': screenshots})
    except Exception as e:
        logger.error(f"[API] Error getting screenshots: {e}")
        import traceback
        logger.error(traceback.format_exc())
        return jsonify({'error': str(e)}), 500


@app.route('/api/screenshots/capture', methods=['POST'])
def capture_screenshot():
    """Capture a new screenshot"""
    try:
        logger.info("[API] Screenshot capture requested")
        result = bot.take_screenshot()
        # Sanitize result path before logging (in case it has problematic characters)
        try:
            safe_result = result.encode('utf-8', errors='replace').decode('utf-8') if result else "None"
            logger.info(f"[API] Screenshot captured: {safe_result}")
        except:
            logger.info("[API] Screenshot captured successfully")
        return jsonify({'success': True, 'message': 'Screenshot captured', 'data': result})
    except Exception as e:
        logger.error(f"[API] Error capturing screenshot: {e}")
        return jsonify({'error': str(e)}), 500


