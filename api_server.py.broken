# PayPal Payment Endpoints
@app.route('/api/payment/paypal/initiate', methods=['POST'])
@rate_limit(payment_rate_limiter)
def initiate_paypal_payment():
    """Initiate a PayPal payment for subscription"""
    try:
        data = request.get_json()
        plan_id = data.get('planId', '').lower()
        price = data.get('price')
        
        # Validate input
        if not input_validator.validate_plan_id(plan_id):
            logger.warning(f"Invalid plan ID attempted: {plan_id}")
            return jsonify({'error': 'Invalid plan ID'}), 400
        
        if not input_validator.validate_amount(price):
            logger.warning(f"Invalid amount attempted: {price}")
            return jsonify({'error': 'Invalid amount'}), 400
        
        # Get price from config
        actual_price = paypal_config.get_price(plan_id)
        if actual_price == 0:
            actual_price = price
        
        # Get PayPal email and URLs
        paypal_email = paypal_config.get_paypal_email()
        if not paypal_email or paypal_email == 'your-paypal-email@example.com':
            # Use actual PayPal email
            paypal_email = 'ClashOfClansBOT2026@outlook.fr'
            logger.info("Using PayPal email for payments")
        
        paypal_url = paypal_config.get_paypal_url()
        return_url = paypal_config.config['return_url']
        cancel_url = paypal_config.config['cancel_url']
        product_name = paypal_config.get_product_name(plan_id)
        invoice_id = f"FARMIFY-{plan_id.upper()}-{int(datetime.now().timestamp())}"
        
        # Log transaction as pending
        transaction_logger.log_transaction(
            invoice_id=invoice_id,
            plan_id=plan_id,
            amount=actual_price,
            status='pending'
        )
        
        # Build PayPal payment URL
        payment_url = (
            f"{paypal_url}?"
            f"cmd=_xclick&"
            f"business={paypal_email}&"
            f"item_name={product_name}&"
            f"amount={actual_price:.2f}&"
            f"currency_code={paypal_config.config['currency_code']}&"
            f"invoice={invoice_id}&"
            f"return={return_url}&"
            f"cancel_return={cancel_url}&"
            f"notify_url={paypal_config.config['webhook_url']}"
        )
        
        logger.info(f"✅ PayPal payment initiated - Plan: {plan_id}, Amount: ${actual_price}, Invoice: {invoice_id}")
        
        return jsonify({
            'success': True,
            'paymentUrl': payment_url,
            'invoiceId': invoice_id,
            'message': f'Redirecting to PayPal for ${actual_price} {plan_id} plan'
        })
    except Exception as e:
        logger.error(f"❌ Error initiating PayPal payment: {e}")
        return jsonify({'error': 'Failed to initiate payment'}), 500


@app.route('/api/payment/paypal/success', methods=['GET'])
def paypal_payment_success():
    """Handle successful PayPal payment"""
    try:
        invoice_id = request.args.get('invoice')
        transaction_id = request.args.get('tx')
        
        if not invoice_id or not transaction_id:
            logger.warning("PayPal success callback missing required parameters")
            return jsonify({
                'success': False,
                'message': 'Invalid payment parameters'
            }), 400
        
        # Parse invoice ID to extract plan
        # Format: FARMIFY-MONTHLY-1234567890
        parts = invoice_id.split('-')
        if len(parts) < 3:
            return jsonify({'success': False, 'message': 'Invalid invoice format'}), 400
        
        plan_id = parts[1].lower()  # 'monthly' or 'yearly'
        
        # Update transaction with PayPal transaction ID
        transaction_logger.update_transaction(invoice_id, {
            'transaction_id': transaction_id,
            'status': 'pending_verification'
        })
        
        logger.info(f"PayPal payment success - Invoice: {invoice_id}, Transaction: {transaction_id}")
        
        return jsonify({
            'success': True,
            'message': 'Payment received! Verifying with PayPal...',
            'invoiceId': invoice_id,
            'transactionId': transaction_id
        })
    except Exception as e:
        logger.error(f"Error processing PayPal success: {e}")
        return jsonify({'error': str(e)}), 500


@app.route('/api/payment/paypal/cancel', methods=['GET'])
def paypal_payment_cancel():
    """Handle cancelled PayPal payment"""
    try:
        invoice_id = request.args.get('invoice')
        logger.info(f"PayPal payment cancelled - Invoice: {invoice_id}")
        
        return jsonify({
            'success': False,
            'message': 'Payment was cancelled. No charges were made.',
            'invoiceId': invoice_id
        })
    except Exception as e:
        logger.error(f"Error processing PayPal cancel: {e}")
        return jsonify({'error': str(e)}), 500


@app.route('/api/payment/paypal/webhook', methods=['POST'])
def paypal_webhook():
    """Handle PayPal IPN webhook for payment verification"""
    try:
        # Get the posted data
        data = request.form.to_dict()
        
        logger.info(f"PayPal IPN received - Transaction ID: {data.get('txn_id')}")
        
        # Verify with PayPal
        verified = verify_paypal_ipn(data)
        
        if not verified:
            logger.warning(f"PayPal IPN verification failed for txn_id: {data.get('txn_id')}")
            return jsonify({'success': False, 'message': 'IPN verification failed'}), 400
        
        logger.info(f"✅ PayPal IPN verified for transaction: {data.get('txn_id')}")
        
        # Handle different transaction types
        txn_type = data.get('txn_type')
        
        if txn_type == 'web_accept' or txn_type == 'subscr_payment':
            # Successful payment
            handle_successful_payment(data)
        elif txn_type == 'refund':
            # Refund processed
            handle_refund(data)
        elif txn_type == 'subscr_cancel' or txn_type == 'subscr_eot':
            # Subscription cancelled or ended
            handle_subscription_cancel(data)
        else:
            logger.info(f"Unhandled IPN type: {txn_type}")
        
        return jsonify({'success': True}), 200
    except Exception as e:
        logger.error(f"Error processing PayPal webhook: {e}")
        return jsonify({'error': str(e)}), 500


def verify_paypal_ipn(data: dict) -> bool:
    """Verify PayPal IPN signature"""
    try:
        # Prepare verification data
        verify_data = {'cmd': '_notify-validate', **data}
        
        # Get PayPal verification URL based on mode
        paypal_url = paypal_config.get_paypal_url()
        
        # Send verification request to PayPal
        response = requests.post(paypal_url, data=verify_data, timeout=10)
        
        if response.text == 'VERIFIED':
            logger.info("✅ PayPal IPN signature verified")
            return True
        else:
            logger.warning(f"❌ PayPal IPN verification failed: {response.text}")
            return False
    except Exception as e:
        logger.error(f"Error verifying PayPal IPN: {e}")
        return False


def handle_successful_payment(data: dict) -> None:
    """Handle successful payment and activate license"""
    try:
        invoice_id = data.get('invoice')
        transaction_id = data.get('txn_id')
        receiver_email = data.get('receiver_email')
        payer_email = data.get('payer_email')
        mc_gross = float(data.get('mc_gross', 0))
        
        if not invoice_id:
            logger.error("No invoice ID in PayPal IPN data")
            return
        
        # Update transaction as verified
        transaction_logger.mark_verified(invoice_id, transaction_id)
        
        # Extract plan from invoice
        parts = invoice_id.split('-')
        if len(parts) < 3:
            logger.error(f"Invalid invoice format: {invoice_id}")
            return
        
        plan_id = parts[1].lower()
        
        # Generate license key
        license_key = license_manager.generate_license_key(plan_id)
        
        # Activate the license
        activation_result = license_manager.activate_license(license_key, plan_id)
        
        if activation_result['success']:
            logger.info(f"✅ License activated: {license_key}")
            
            # Update transaction with license key
            transaction_logger.update_transaction(invoice_id, {
                'status': 'verified',
                'license_key': license_key,
                'activated_at': datetime.now().isoformat()
            })
            
            # Send confirmation email to user
            email_notifier.send_payment_confirmation(
                recipient_email=payer_email,
                plan_id=plan_id,
                amount=mc_gross,
                invoice_id=invoice_id,
                transaction_id=transaction_id
            )
            
            # Send license activation email
            license_status = license_manager.get_license_status()
            expiry_date = license_status.get('expiry_date', 'Unknown')
            
            email_notifier.send_license_activation(
                recipient_email=payer_email,
                plan_id=plan_id,
                license_key=license_key,
                expiry_date=expiry_date
            )
            
            logger.info(f"📧 Confirmation emails sent to {payer_email}")
        else:
            logger.error(f"Failed to activate license: {activation_result.get('error')}")
            transaction_logger.mark_failed(invoice_id, "License activation failed")
        
    except Exception as e:
        logger.error(f"Error handling successful payment: {e}")


def handle_refund(data: dict) -> None:
    """Handle refund notification"""
    try:
        parent_txn_id = data.get('parent_txn_id')
        reason_code = data.get('reason_code', 'unknown')
        mc_gross = data.get('mc_gross', 0)
        payer_email = data.get('payer_email')
        
        # Find original transaction
        original_transaction = transaction_logger.get_transaction_by_tx_id(parent_txn_id)
        
        if original_transaction:
            invoice_id = original_transaction['invoice_id']
            
            # Mark as refunded
            transaction_logger.mark_refunded(invoice_id, f"Refund reason: {reason_code}")
            
            # Deactivate license
            license_manager.deactivate_license()
            
            logger.info(f"✅ License deactivated due to refund")
            
            # Send refund notification email
            email_notifier.send_refund_notification(
                recipient_email=payer_email,
                invoice_id=invoice_id,
                amount=float(mc_gross),
                reason=reason_code
            )
            
            logger.info(f"📧 Refund notification sent to {payer_email}")
        else:
            logger.warning(f"Refund received but no matching transaction found: {parent_txn_id}")
    
    except Exception as e:
        logger.error(f"Error handling refund: {e}")


def handle_subscription_cancel(data: dict) -> None:
    """Handle subscription cancellation"""
    try:
        subscr_id = data.get('subscr_id')
        payer_email = data.get('payer_email')
        
        logger.info(f"Subscription cancelled: {subscr_id}")
        
        # Deactivate license
        license_manager.deactivate_license()
        
        logger.info(f"✅ License deactivated due to subscription cancellation")
        
        # Send notification
        email_notifier.send_email_notification(
            recipient_email=payer_email,
            subject="Farmify Subscription Cancelled",
            body=f"Your subscription {subscr_id} has been cancelled. Free plan features remain available."
        )
    
    except Exception as e:
        logger.error(f"Error handling subscription cancel: {e}")


