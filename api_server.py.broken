            print(f"[CRITICAL] Could not setup any logger: {e3}")
            startup_logger = None

# ============================================================================
# STARTUP DIAGNOSTICS - Wrapped in try-except to prevent crashes
# ============================================================================

try:
    if startup_logger:
        startup_logger.info("="*80)
        startup_logger.info("FARMIFY API SERVER - STARTUP DIAGNOSTICS")
        startup_logger.info("="*80)
        startup_logger.info(f"Frozen: {getattr(sys, 'frozen', False)}")
        startup_logger.info(f"Executable: {sys.executable}")
        startup_logger.info(f"CWD: {os.getcwd()}")
        startup_logger.info("="*80)

    # Diagnostic 1: Check sys.path
    if startup_logger:
        startup_logger.info("Checking sys.path for modules...")
for i, path in enumerate(sys.path[:5]):
    startup_logger.info(f"  [{i}] {path}")

# Diagnostic 2: Check for app_paths.py
startup_logger.info("Searching for app_paths.py...")
found_app_paths = False
for path in sys.path[:15]:
    locations_to_check = [
        (path, 'root'),
        (os.path.join(path, 'utils'), 'utils/'),
        (os.path.join(path, 'src', 'utils'), 'src/utils/'),
    ]
    
    for location, desc in locations_to_check:
        app_paths_py = os.path.join(location, 'app_paths.py')
        if os.path.isfile(app_paths_py):
            startup_logger.info(f"  ✅ Found {desc}app_paths.py at: {app_paths_py}")
            found_app_paths = True

if not found_app_paths:
    startup_logger.error("  ❌ app_paths.py NOT FOUND ANYWHERE IN sys.path")
    startup_logger.error("     This is the ROOT CAUSE of [Errno 22] errors!")

# Diagnostic 3: Try to import app_paths
startup_logger.info("Testing import paths...")
get_app_data_dir = None
import_source = None

# Try 1: src.utils.app_paths
try:
    from src.utils.app_paths import get_app_data_dir as func1
    get_app_data_dir = func1
    import_source = 'src.utils.app_paths'
    startup_logger.info(f"  ✅ Successfully imported from: {import_source}")
except Exception as e:
    startup_logger.warning(f"  ❌ from src.utils.app_paths: {str(e)[:80]}")

# Try 2: utils.app_paths
if get_app_data_dir is None:
    try:
        from utils.app_paths import get_app_data_dir as func2
        get_app_data_dir = func2
        import_source = 'utils.app_paths'
        startup_logger.info(f"  ✅ Successfully imported from: {import_source}")
    except Exception as e:
        startup_logger.warning(f"  ❌ from utils.app_paths: {str(e)[:80]}")

# Try 3: app_paths
if get_app_data_dir is None:
    try:
        from app_paths import get_app_data_dir as func3
        get_app_data_dir = func3
        import_source = 'app_paths'
        startup_logger.info(f"  ✅ Successfully imported from: {import_source}")
    except Exception as e:
        startup_logger.warning(f"  ❌ from app_paths: {str(e)[:80]}")

# Diagnostic 4: Test the function
if get_app_data_dir is not None:
    try:
        app_data_path = get_app_data_dir()
        startup_logger.info(f"  ✅ get_app_data_dir() returned: {app_data_path}")
        startup_logger.info(f"     Is absolute: {os.path.isabs(app_data_path)}")
        startup_logger.info(f"     Type: {type(app_data_path).__name__}")
        startup_logger.info(f"     Exists: {os.path.isdir(app_data_path)}")
    except Exception as e:
        startup_logger.error(f"  ❌ Failed to call get_app_data_dir(): {e}")
        get_app_data_dir = None
else:
    startup_logger.error("  ❌ ALL IMPORT ATTEMPTS FAILED")
    startup_logger.error("     ROOT CAUSE: app_paths.py is not available in frozen app")
    startup_logger.error("     RESULT: Modules will use fallback paths")
    startup_logger.error("     OUTCOME: [Errno 22] errors expected on file operations")

# Diagnostic 5: Test file operations
startup_logger.info("Testing file operations...")
try:
    test_dir = os.path.join(os.path.expanduser('~'), 'AppData', 'Local', 'Farmify', 'test')
    os.makedirs(test_dir, exist_ok=True)
    
    test_file = os.path.join(test_dir, 'diagnostic_test.txt')
    test_file = os.path.abspath(test_file)
    
    # Try to write
    with open(test_file, 'w') as f:
        f.write("diagnostic test")
    
    # Try to read
    with open(test_file, 'r') as f:
        content = f.read()
    
    # Clean up
    os.remove(test_file)
    
    startup_logger.info(f"  ✅ File operations working")
except Exception as e:
    startup_logger.error(f"  ❌ File operations failed: {e}")
    if hasattr(e, 'errno'):
        startup_logger.error(f"     Errno: {e.errno} (This is what causes the [Errno 22] errors)")

    # Final verdict
    startup_logger.info("="*80)
    if get_app_data_dir is not None and import_source is not None:
        startup_logger.info("✅ DIAGNOSTICS PASSED - app_paths imported successfully")
        startup_logger.info(f"   Import source: {import_source}")
    else:
        startup_logger.critical("❌ DIAGNOSTICS FAILED - app_paths import unsuccessful")
        startup_logger.critical("   [Errno 22] errors will occur when trying to save files")
    startup_logger.info("="*80)

except Exception as e:
    # Diagnostics failed - but don't crash the app
    print(f"[CRITICAL] Startup diagnostics failed: {e}")
    import traceback
    traceback.print_exc()
    if startup_logger:
        try:
            startup_logger.error(f"[CRITICAL] Startup diagnostics crashed: {e}")
            startup_logger.error(traceback.format_exc())
        except:
            pass

# ============================================================================
# END STARTUP DIAGNOSTICS
# ============================================================================

